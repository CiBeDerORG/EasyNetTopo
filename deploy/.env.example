# 将 CiBeDerORG/EasyTier 克隆到任意总目录下的 easytier/。
# 唯一入口 ./easytier/deploy.sh；本文件首次自动复制为 easytier/.env。
# 每行 KEY=value；支持整值单/双引号，值按字面读取，不执行 shell、不展开 ${VAR}。
# 注释放单独一行；秘密包含 #、$、= 或空格时可用单引号包裹。

# 留空使用当前分支。填写如 feat/ecosystem-web-ui；update 只允许快进。
GIT_BRANCH=
COMPOSE_PROJECT_NAME=easytier-modding

# 工具链匹配仓库 CI。更换这些版本会重建开发环境镜像。
RUST_VERSION=1.95
NODE_VERSION=22
PNPM_VERSION=10.34.7
PROTOC_VERSION=35.1
CARGO_BUILD_PROFILE=dev
CARGO_BUILD_JOBS=2

# 默认启用源码监听。首次 Rust 编译可能较久；超时不会删除缓存。
EASYTIER_WATCH=true
EASYTIER_POLL_INTERVAL=1
EASYTIER_DEBOUNCE=1
START_TIMEOUT=1800

# 浏览器访问 http://localhost:11210，API 经同源 /api/ 代理。
# 改成 0.0.0.0 可从其他主机访问；远程管理员页面需 HTTPS 公共来源。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=11210
# API 直接端口默认仅本机可用；容器间仍使用 backend 服务名。
API_BIND_ADDRESS=127.0.0.1
ET_API_SERVER_PORT=11211
# 配置服务供 EasyTier 节点连接；支持 udp、tcp 或 ws。
CONFIG_BIND_ADDRESS=0.0.0.0
ET_CONFIG_SERVER_PORT=22020
ET_CONFIG_SERVER_PROTOCOL=udp

# 可选；HTTPS 反向代理示例 https://easytier.example.invalid（不要带路径）。
# 空值会从后端环境移除。当前项目仅允许 HTTPS 或 loopback HTTP 管理来源。
ET_WEB_PUBLIC_ORIGIN=
ET_DISABLE_REGISTRATION=false
ET_ALLOW_AUTO_CREATE_USER=false

# 可选 Webhook / 内部 API 共享密钥。空值表示不启用，不提供固定默认密钥。
ET_WEBHOOK_URL=
ET_WEBHOOK_SECRET=
ET_INTERNAL_AUTH_TOKEN=
ET_WEB_INSTANCE_ID=
ET_WEB_INSTANCE_API_BASE_URL=
ET_GATEWAY_PEER_URL=
ET_GATEWAY_RELAY_DATA=false

# 通过反向代理使用 HMR 时按需填写。host 只写域名；协议 ws 或 wss。
VITE_HMR_HOST=
VITE_HMR_PORT=
VITE_HMR_PROTOCOL=
# 自定义域名以逗号分隔；留空使用 Vite 默认允许的 localhost/IP。
VITE_ALLOWED_HOSTS=
