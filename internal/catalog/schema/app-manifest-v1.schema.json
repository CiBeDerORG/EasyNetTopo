{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CiBeDerORG/deploy/blob/main/schema/app-manifest-v1.schema.json",
  "title": "Deploy App Manifest v1",
  "description": "Machine-readable app.yaml for EasyTier central Deploy store. Docker Compose only in v1. Descriptions are data, not permission to run arbitrary commands. The T03-01 semantic validator (tools/validate_app_manifest.py) additionally enforces path ownership, Compose consistency, and package/script dependencies; schema validation alone grants no execution permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "summary",
    "category",
    "runtime",
    "compatibility",
    "package",
    "config",
    "ports",
    "actions",
    "verification",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64,
      "description": "Stable application identifier; MUST match Deploy repository application directory."
    },
    "name": {
      "type": "string",
      "description": "Display name.",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "description": "User-facing short description.",
      "minLength": 1,
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "enum": [
        "infrastructure",
        "network",
        "developer",
        "media",
        "productivity",
        "other"
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "maxLength": 500
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "compose_project",
        "compose_file"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "docker_compose"
        },
        "compose_project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64,
          "description": "Exact compose project/name: value in docker-compose.yaml."
        },
        "compose_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "description": "Relative to <SOFTWARE_ROOT>/<id>, usually deploy/docker-compose.yaml."
        },
        "requires_root": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "architectures"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "linux",
              "fnos"
            ]
          }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "requires_docker": {
          "type": "boolean",
          "const": true
        },
        "requires_compose_v2": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
                "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
              },
              "destination": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
                "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "0644",
                  "0755"
                ],
                "default": "0644"
              }
            }
          },
          "description": "Source path repository-root-relative; destination SOFTWARE_ROOT-relative. All dependencies explicitly listed; no whole-repository deployment."
        }
      }
    },
    "config": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "target",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "minLength": 2,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "description": "Human-readable label."
          },
          "description": {
            "type": "string",
            "description": "User-facing help text, no secrets."
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "port",
              "ipv4",
              "secret"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "env",
              "secrets"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ],
            "description": "No default for secret fields unless empty string. NEVER commit real tokens/passwords."
          },
          "min_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "max_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "pattern": {
            "type": "string",
            "maxLength": 500
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "generated_by_script": {
            "type": "boolean",
            "description": "True: existing install.sh creates a missing/blank credential and persists it without revealing the value."
          },
          "editable": {
            "type": "boolean",
            "default": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "secret"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "target": {
                  "const": "secrets"
                },
                "default": {
                  "const": ""
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target": {
                  "const": "secrets"
                }
              },
              "required": [
                "target"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "secret"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "port"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "maximum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        ]
      },
      "description": "Only declared keys exposed; global SOFTWARE_ROOT/deploy/.env and .secrets are runtime config, not bundled file inputs."
    },
    "ports": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "protocol",
          "purpose",
          "host_port_key",
          "container_port"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "description": "UI title."
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "web",
              "other"
            ]
          },
          "host_port_key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "minLength": 2,
            "maxLength": 120
          },
          "bind_address_key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "minLength": 2,
            "maxLength": 120
          },
          "container_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service": {
            "type": "string",
            "description": "Compose service name.",
            "minLength": 1,
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "description": "HTTP path for display, optional.",
            "pattern": "^/[^?#]*$",
            "maxLength": 255
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install"
      ],
      "properties": {
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "script",
                "compose_down"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
              "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 5,
              "default": []
            },
            "remove_orphans": {
              "type": "boolean",
              "default": false
            },
            "description": {
              "type": "string",
              "description": "UI description of action."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "script"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "compose_down"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          ]
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "script",
                "compose_down"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
              "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 5,
              "default": []
            },
            "remove_orphans": {
              "type": "boolean",
              "default": false
            },
            "description": {
              "type": "string",
              "description": "UI description of action."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "script"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "compose_down"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          ]
        },
        "uninstall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "script",
                "compose_down"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
              "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 5,
              "default": []
            },
            "remove_orphans": {
              "type": "boolean",
              "default": false
            },
            "description": {
              "type": "string",
              "description": "UI description of action."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "script"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "compose_down"
                  }
                },
                "required": [
                  "strategy"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "required_services",
        "state"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "docker_compose"
        },
        "required_services": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "Compose service name.",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "healthy"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1200,
          "default": 180
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "description": "User-data path under SOFTWARE_ROOT relative to root, e.g. portainer/data; a blank list means no managed data paths. Must be verified against Compose mount ownership."
          }
        },
        "named_volumes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 64
          },
          "default": []
        },
        "default_retain": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "description": "POSIX safe, repository/root-relative path; no .. or absolute paths; semantic checker also rejects symlink, hidden credentials, special files."
    }
  }
}
